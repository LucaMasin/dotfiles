[Unit]
Description=OpenCode V2 web server (Tailscale-only)

[Service]
Type=simple
ExecStart=/usr/bin/env opencode2 serve --hostname 127.0.0.1 --port 4097
EnvironmentFile=%h/.config/opencode/server.env
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h

[Install]
WantedBy=default.target
