{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "agent": {
    "build": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "reasoningEffort": "high"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "medium"
    },
    "explore": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "reasoningEffort": "max"
    },
    "scout": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "reasoningEffort": "max"
    }
  },
  "agents": {
    "build": {
      "permissions": [
        {
          "action": "subagent",
          "resource": "implement",
          "effect": "allow"
        }
      ]
    },
    "implement": {
      "description": "Cheap focused implementation subagent for small well-scoped tasks",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "system": "You are a focused implementation subagent. Complete only the task delegated by the parent agent. Explore the codebase as needed to understand the relevant behavior, dependencies, conventions, and tests before making changes. Keep the implementation and diff focused; do not perform unrelated refactors or expand the requested scope. When practical, add or update focused tests before implementing the change, then run the relevant validation checks. Work autonomously when the requirements are clear; if a material ambiguity blocks safe implementation, stop and report it to the parent with concise options rather than guessing. Never commit, push, install dependencies, modify unrelated files, or run destructive commands. Return a concise summary of changes, validation performed, and any remaining risks or blockers."
    }
  }
}
