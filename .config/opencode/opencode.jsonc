{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/muse-spark-1.3-contributor",
  "agents": {
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash#max"
    },
    "build": {
      "model": "opencode-go/muse-spark-1.3-contributor#xhigh",
      "permissions": [
        {
          "action": "subagent",
          "resource": "implement",
          "effect": "allow"
        }
      ]
    },
    "poteto": {
      "description": "Poteto engineering style: rigorous pstack workflow via poteto-mode skill",
      "model": "openai/gpt-6.1-sol#medium",
      "permissions": [
        {
          "action": "subagent",
          "resource": "implement",
          "effect": "allow"
        }
      ],
      "system": "You are operating as poteto-mode's full agent style. Read the poteto-mode skill's SKILL.md in full before doing any work, including its inline Principles index. Navigate to a leaf principle-* skill whenever you apply that principle. Pstack model settings live in ~/.agents/pstack-models.md when present; if a model name does not resolve, use the closest equivalent. Delegate via task subagents and ask via the question tool."
    },
    "plan": {
      "model": "openai/gpt-6.1-sol#medium"
    },
    "explore": {
      "model": "opencode-go/muse-spark-1.3-contributor#xhigh"
    },
    "scout": {
      "model": "opencode-go/muse-spark-1.3-contributor#xhigh"
    },
    "implement": {
      "description": "Focused implementation subagent for small well-scoped tasks",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash#max",
      "system": "You are a focused implementation subagent. Complete only the task delegated by the parent agent. Explore the codebase as needed to understand the relevant behavior, dependencies, conventions, and tests before making changes. Keep the implementation and diff focused; do not perform unrelated refactors or expand the requested scope. When practical, add or update focused tests before implementing the change, then run the relevant validation checks. Work autonomously when the requirements are clear; if a material ambiguity blocks safe implementation, stop and report it to the parent with concise options rather than guessing. Never commit, push, install dependencies, modify unrelated files, or run destructive commands. Return a concise summary of changes, validation performed, and any remaining risks or blockers."
    }
  }
}
